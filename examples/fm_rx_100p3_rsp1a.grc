options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Baseline broadcast WBFM receiver, 100.3 MHz, SDRplay RSP1A via SoapySDR
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: fm_rx_100p3_rsp1a
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: WBFM Receiver 100.3 MHz (RSP1A)
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: RSP1A sample rate (2.4 MS/s / 10 = 240 kS/s quad rate)
    value: '2400000'
  states:
    coordinate: [200, 12]
    rotation: 0
    state: enabled
- name: quad_rate
  id: variable
  parameters:
    comment: Rate into the WBFM demod
    value: '240000'
  states:
    coordinate: [320, 12]
    rotation: 0
    state: enabled
- name: audio_rate
  id: variable
  parameters:
    comment: ''
    value: '48000'
  states:
    coordinate: [440, 12]
    rotation: 0
    state: enabled
- name: station_freq
  id: variable
  parameters:
    comment: Station frequency
    value: '100.3e6'
  states:
    coordinate: [560, 12]
    rotation: 0
    state: enabled
- name: lo_offset
  id: variable
  parameters:
    comment: Tune off-station so the SDR DC spike lands outside the FM channel
    value: '250e3'
  states:
    coordinate: [680, 12]
    rotation: 0
    state: enabled
- name: tune_freq
  id: variable
  parameters:
    comment: Actual RSP1A LO frequency
    value: station_freq - lo_offset
  states:
    coordinate: [800, 12]
    rotation: 0
    state: enabled
- name: channel_taps
  id: variable
  parameters:
    comment: ~200 kHz FM channel filter
    value: firdes.low_pass(1.0, samp_rate, 100e3, 50e3, window.WIN_HAMMING, 6.76)
  states:
    coordinate: [920, 12]
    rotation: 0
    state: enabled
- name: gain
  id: variable_qtgui_range
  parameters:
    comment: RSP1A IF gain reduction = 59 - this value
    gui_hint: 0,0,1,1
    label: IF Gain (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '0'
    step: '1'
    stop: '39'
    value: '30'
    widget: counter_slider
  states:
    coordinate: [1064, 12]
    rotation: 0
    state: enabled
- name: lna_state
  id: variable_qtgui_range
  parameters:
    comment: 0 = max sensitivity; raise if strong stations overload
    gui_hint: 0,1,1,1
    label: LNA State
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '0'
    step: '1'
    stop: '9'
    value: '4'
    widget: counter_slider
  states:
    coordinate: [1064, 124]
    rotation: 0
    state: enabled
- name: volume
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 0,2,1,1
    label: Volume
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.05'
    stop: '2'
    value: '0.5'
    widget: counter_slider
  states:
    coordinate: [1064, 236]
    rotation: 0
    state: enabled

- name: rsp1a
  id: soapy_sdrplay_source
  parameters:
    affinity: ''
    agc: 'False'
    agc_setpoint: '-30'
    alias: ''
    antenna: Antenna A
    bandwidth: '0'
    bias: ''
    center_freq: tune_freq
    comment: SoapySDRPlay driver; needs the SDRplay API service installed
    dev_args: '""'
    freq_correction: '0'
    gain: gain
    lna_state: lna_state
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fc32
  states:
    coordinate: [24, 220]
    rotation: 0
    state: enabled
- name: notch_off
  id: snippet
  parameters:
    alias: ''
    code: |-
      # RSP1A has a built-in FM broadcast notch; it must be off to receive FM
      for _name in ('rfnotch_ctrl', 'dabnotch_ctrl'):
          try:
              self.rsp1a.write_setting(_name, False)
          except Exception as e:
              print('could not set', _name, e)
    comment: Disable RSP1A broadcast (FM) and DAB notch filters
    priority: '0'
    section: main_after_init
  states:
    coordinate: [24, 380]
    rotation: 0
    state: enabled
- name: channel_select
  id: freq_xlating_fir_filter_xxx
  parameters:
    affinity: ''
    alias: ''
    center_freq: lo_offset
    comment: Shift station to 0 Hz, filter to the FM channel, decimate 2.4M -> 240k
    decim: '10'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    taps: channel_taps
    type: ccf
  states:
    coordinate: [320, 228]
    rotation: 0
    state: enabled
- name: fm_demod
  id: analog_wfm_rcv
  parameters:
    affinity: ''
    alias: ''
    audio_decimation: '5'
    comment: Wideband FM demod incl. 75 us de-emphasis; 240k -> 48k
    maxoutbuf: '0'
    minoutbuf: '0'
    quad_rate: quad_rate
  states:
    coordinate: [560, 228]
    rotation: 0
    state: enabled
- name: volume_ctl
  id: blocks_multiply_const_vxx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    const: volume
    maxoutbuf: '0'
    minoutbuf: '0'
    type: float
    vlen: '1'
  states:
    coordinate: [784, 236]
    rotation: 0
    state: enabled
- name: audio_out
  id: audio_sink
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    device_name: ''
    num_inputs: '1'
    ok_to_block: 'True'
    samp_rate: audio_rate
  states:
    coordinate: [976, 236]
    rotation: 0
    state: enabled

- name: rf_spectrum
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: samp_rate
    color1: '"blue"'
    comment: Raw RSP1A spectrum around the LO (station sits at +250 kHz)
    ctrlpanel: 'False'
    fc: tune_freq
    fftsize: '2048'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: 1,0,3,3
    label: Relative Gain
    label1: ''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"RF Spectrum (RSP1A)"'
    nconnections: '1'
    showports: 'False'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    width1: '1'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '0'
    ymin: '-120'
  states:
    coordinate: [320, 380]
    rotation: 0
    state: enabled
- name: channel_spectrum
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: quad_rate
    color1: '"red"'
    comment: Selected FM channel, centred on the station
    ctrlpanel: 'False'
    fc: station_freq
    fftsize: '2048'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: 4,0,3,3
    label: Relative Gain
    label1: ''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"Channel (100.3 MHz)"'
    nconnections: '1'
    showports: 'False'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_tag: '""'
    type: complex
    update_time: '0.10'
    width1: '1'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '0'
    ymin: '-120'
  states:
    coordinate: [560, 380]
    rotation: 0
    state: enabled
- name: audio_spectrum
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    autoscale: 'False'
    average: '0.2'
    axislabels: 'True'
    bw: audio_rate
    color1: '"dark green"'
    comment: Recovered audio
    ctrlpanel: 'False'
    fc: '0'
    fftsize: '2048'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: 7,0,3,3
    label: Relative Gain
    label1: ''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"Demodulated Audio"'
    nconnections: '1'
    showports: 'False'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_tag: '""'
    type: float
    update_time: '0.10'
    width1: '1'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '10'
    ymin: '-120'
  states:
    coordinate: [784, 380]
    rotation: 0
    state: enabled

connections:
- [rsp1a, '0', rf_spectrum, '0']
- [rsp1a, '0', channel_select, '0']
- [channel_select, '0', channel_spectrum, '0']
- [channel_select, '0', fm_demod, '0']
- [fm_demod, '0', volume_ctl, '0']
- [volume_ctl, '0', audio_out, '0']
- [fm_demod, '0', audio_spectrum, '0']

metadata:
  file_format: 1
  grc_version: 3.10.9.2
